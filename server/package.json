{
  "name": "yuque-ai-mcp",
  "version": "4.0.0",
  "description": "Yuque MCP Server — 65 tools (Yuque OpenAPI coverage + 20 web-API tools requiring browser session cookie)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "yuque-mcp": "dist/cli.js",
    "yuque-mcp-http": "dist/cli-http.js"
  },
  "files": [
    "dist/",
    "config/config.example.json",
    "references/api/",
    "SKILL.md",
    "README.md",
    "README_CN.md",
    "LICENSE"
  ],
  "keywords": [
    "yuque",
    "mcp",
    "model-context-protocol",
    "ai",
    "llm",
    "claude",
    "语雀"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "dev:http": "tsx watch src/http.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "prepack": "npm run build && node scripts/copy-assets.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yehuoshun/yuque-ai-mcp"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.25 || ^4.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.4.0"
  }
}
